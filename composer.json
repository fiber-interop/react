{
    "name": "fiber-interop/react",
    "description": "ReactPHP adapter for fiber-interop/api: go, await, sleep, readable, writable on the React event loop.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "*",
        "react/event-loop": "^1.5",
        "react/promise": "^3",
        "react/async": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "repositories": [
        { "type": "path", "url": "../api" },
        { "type": "path", "url": "../scope" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "FiberInterop\\React\\": "src/" },
        "files": ["src/register.php"]
    },
    "autoload-dev": {
        "psr-4": { "FiberInterop\\React\\Tests\\": "tests/" }
    },
    "config": { "allow-plugins": {} }
}
